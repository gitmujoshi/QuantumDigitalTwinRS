# Langfuse headless init (local dev only). Used by: docker compose --env-file docker/langfuse.init.env
# Do not quote values. See https://langfuse.com/self-hosting/administration/headless-initialization

LANGFUSE_INIT_ORG_ID=twinsentry
LANGFUSE_INIT_ORG_NAME=TwinSentry
LANGFUSE_INIT_PROJECT_ID=twinsentry-rs
LANGFUSE_INIT_PROJECT_NAME=TwinSentry-RS
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=lf_pk_twinsentry_dev
LANGFUSE_INIT_PROJECT_SECRET_KEY=lf_sk_twinsentry_dev
LANGFUSE_INIT_USER_EMAIL=admin@twinsentry.local
LANGFUSE_INIT_USER_NAME=TwinSentryAdmin
LANGFUSE_INIT_USER_PASSWORD=twinsentry-dev

NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=twinsentry-langfuse-dev-secret
